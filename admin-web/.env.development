# 开发环境变量。★ 只有 VITE_ 开头的才会暴露给前端代码

VITE_APP_TITLE=管理端

# ★ 网关地址。开发期从 http://localhost:3000/admin/ 进入，不要直接开 5175
#   —— 那是另一个 origin，读不到另外两端的登录态。
VITE_GATEWAY_URL=http://localhost:3000

# ★ 401 时统一跳到【阅读端】登录页，三个应用这一项必须是同一个值（项目大纲 §7.5）
#   留空则自动取 ${VITE_GATEWAY_URL}/reader。
VITE_READER_WEB_URL=

VITE_API_BASE_URL=/api
