<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.novel</groupId>
        <artifactId>novel-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>novel-auth</artifactId>
    <name>novel-auth</name>
    <description>小说管理系统 · 认证服务（M1 从单体里摘出来的第一个服务，8081）</description>

    <!--
      ============================================================
      M1：第一个被摘出来的服务
      ============================================================
      这个模块 = 第一期的 com.novel.modules.system 整个包（58 个类 / 7 张表）：
          登录注册、用户、角色权限、作者申请、公告、ping

      ★ 为什么先摘它（大纲 §九 的原话）：
          边界最清晰、被依赖最多。整个包对外只有 2 个文件 5 行 import
          （都在 content 里，见 ContentUserLookup 与那条审计接缝），
          而且它自己不 import 任何别的业务模块 —— 切面是干净的。

      ★ 为什么它【不对外暴露】：M1 起 8080 网关是唯一入口，
        novel-auth 和 novel-content / novel-interaction 都退到内网端口。生产靠网络隔离
        （docs/部署.md 里 Nginx 是唯一入口），开发期直连 8081/8082/8083
        仅供排错 —— 见 application-dev.yml 顶上那段。

      ★ 依赖清单为什么和 novel-content / novel-interaction 几乎一样：
        它是个【完整的 servlet 服务】，不是个库 —— 有自己的 Controller、
        Service、Mapper、Security 过滤链、Redis 登录态、上传头像。
        唯一少的是 AI 那部分（那是 content 的）。

      ★ 下面那两个 Feign 依赖是 M1 后半段才加的（先建骨架、再搬代码、最后接线），
        它们的注释在 dependencies 里。
    -->

    <dependencies>

        <!-- 共用的 Result / 异常 / JwtUtil / TokenStore / LoginUser / 技术配置（M1 起） -->
        <dependency>
            <groupId>com.novel</groupId>
            <artifactId>novel-common</artifactId>
        </dependency>

        <!-- ==================== Web ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：@NotNull / @Size / @Email 这些注解靠它 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          ==================== 消息队列（M3 新增） ====================
          ★ 版本在父 pom 的 dependencyManagement 里，见那边为什么叫
            rocketmq-spring.version 而不是 rocketmq.version。

          ★★ auth 在 M3 里【只发不收】，而且只发一条：AUDIT_RECORD（审核流水）。

          ★★★ 这一条依赖的意义不是「加了个发消息的能力」，是【断掉一个环】：
            M2 之后 novel-auth → novel-content 有且只有一条出站边，
            就是 ContentAuditClient 那一次 Feign 写（审核流水）。
            M3 把它改成发消息之后，grep 一下
                grep -rn "novel-content\|ContentAuditClient" backend/novel-auth/src/
            必须是 0 命中 —— 环 #1（novel-auth ⇄ novel-content）就此断开。
            ★ 顺带把 openfeign / loadbalancer 两个依赖也删了（见下面那一段），
              于是这条保证从「记得复核」升级成了「编译期就写不出来」。

          ★ 为什么这里【必须】用事务消息而不是普通消息：
            审核流水是在一个 @Transactional 的 audit() 里面写的，
            而 Feign 不参与调用方的事务 —— M2 之后 auth 一旦回滚，
            content 里就留下一条【不会有人删的孤儿流水】。
            事务消息是这条接缝唯一能恢复原子性的机制。
            ★ 但写法有讲究（在外层事务里直接返回 COMMIT 是错的），
              见 AuthorApplyAuditProducer 上的注释（判断 C′）。
        -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
        </dependency>

        <!--
          ==================== 注册中心 ====================
          ★ 网关的路由写的是 lb://novel-auth —— 没有这个依赖，
            它会去 Nacos 找 novel-auth，然后「找不到实例」。
        -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ==================== 持久层 ==================== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!--
          ★ 分页插件 PaginationInnerInterceptor 要靠它拼 LIMIT。
            缺了第一次调分页接口就报 NoClassDefFoundError: net/sf/jsqlparser/...
            报错完全看不出和分页有关（同 novel-interaction 那条注释）。
            用户列表 / 角色列表 / 公告列表 / 作者申请列表都是分页的，必需。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 缓存 / 登录态 ==================== -->
        <!--
          ★★ 这个依赖是 M1 的【命门】之一，别当成普通依赖看：
             登录态（LoginUser）存在 Redis 里，网关每个请求都要去读一次
             才能判断「这个 token 还有效吗」。所以 Redis 的序列化配置
             必须是【同一份】—— 见 novel-common 的 com.novel.common.config.RedisConfig，
             那个类在 M1 从 novel-backend 搬到了 novel-common，就是为了
             让网关能 @Import 同一个类，而不是复制一份（复制 = 全站静默登出）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- ==================== 接口文档 ==================== -->
        <!--
          ★ M2 之后接口文档有【三个】入口（M0 决定网关不透传 knife4j）：
              :8081/doc.html —— 本服务的（登录/用户/角色/菜单/公告/作者申请）
              :8082/doc.html —— novel-content 的（作品/章节/搜索/AI）
              :8083/doc.html —— novel-interaction 的（评论/书架/阅读历史）
            这是开发期唯三不走 :3000 的入口，见 docs/M1-摘出auth.md。
        -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <!-- ==================== 工具 ==================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================== 认证授权 ==================== -->
        <!--
          ★★ spring-boot-starter-security 一旦引入就【自动拦截所有接口】，
             放行规则写在 com.novel.auth.config.AuthSecurityConfig。
             两者必须同时存在，单独加依赖 = 全站 401。

          ★ M1 之后这个服务的鉴权方式变了：它【不再自己验签 JWT】，
            改成读网关写下的 X-User-Id 等请求头（见 novel-common 的
            HeaderAuthenticationFilter）。所以这里要的只是 Spring Security
            的 URL 闸能力（hasRole / authenticated），不是它的认证能力。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
          ★ jjwt-impl / jjwt-jackson 不在这里声明：novel-common 已经用
            runtime scope 引了，会传递过来。JWT 相关依赖统一由 novel-common
            负责 —— 因为 JwtUtil 在那边。

          ★ M1 说明：novel-auth 【签】token（登录），网关【验】token。
            两边用的 JwtUtil 是同一个类、同一份密钥配置，所以这里需要 jjwt-api。
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>

        <!-- ==================== 服务间调用：★ M3 起【一个都没有】 ====================

          ★★★ 这里原来是 spring-cloud-starter-openfeign 与
              spring-cloud-starter-loadbalancer 两个依赖，M3 全部删掉了。

              它们只为一条边存在：审核作者申请后让 novel-content 写审核流水
                 审完 → ContentAuditClient.recordAuthorApplyAudit(...)
                      → POST novel-content:/internal/author-apply-audit-logs

              M3 把那条边换成了事务消息（见上面的 rocketmq 那一段），
              于是 ContentAuditClient / AuthorApplyAuditRecorder / 它的实现
              三个类一起删了，@EnableFeignClients 也从启动类上摘了。

          ★★ 为什么连依赖一起删，而不是「反正留着也不占地方」：
              这两个依赖留着，本服务就【随时可以】再写一个 @FeignClient 出去，
              而那条边当初是环的一半。删掉之后，
              「novel-auth 不再依赖 novel-content」这件事
              从一条需要靠 grep 复核的纪律，变成了一个编译期事实 ——
              没有 Feign 的 API，写不出跨服务调用。
              ★ 同 novel-gateway 那条「spring-boot-starter-web 一进 classpath
                就起不来」的红线，是同一类做法：把纪律变成结构。

          ★ 复核命令（M3 的验收项之一，两条都要符合预期）：
                ls backend/novel-auth/src/main/java/com/novel/auth/client/   → 目录不存在
                mvn -f backend/pom.xml -pl novel-auth -am dependency:tree \
                  | sed -n '/com.novel:novel-auth:jar/,$p' | grep -iE "feign|loadbalancer" → 0
            ★ 阳性对照：第二条换成 -pl novel-interaction 立刻 8 命中（那边还在用 Feign）——
              没有它，「0 命中」和「命令写错了」长得一样。

          ★★ M3 订正：这里原来写的是
                grep -rn "novel-content\|ContentAuditClient" backend/novel-auth/src/
                grep -rn "openfeign\|loadbalancer" backend/novel-auth/pom.xml
             两条【都永远不可能 0 命中】，而且命中全是注释 ——
             实测第一条 33 命中（讲历史的注释、讲三份 yml 的值要一致的话），
             第二条 3 命中（★ 其中一条就是上面这段注释自己写的那个词）。
             ★ 判据钉在一个【词】上就是这个下场：噪音把它淹没，然后没人再看它。
               钉在「有没有这条边」上才对 —— 包、依赖树，
               这两样是结构性的，注释里提多少次都不影响它们。

          ★★ 要说清楚的是：本服务仍然【被】别人调用
              （content → auth 读用户昵称，见 InternalUserController），
              所以 /internal/** 那一套（白名单 + 内部令牌闸门）一个字都不能动。
              「没有出站」和「没有入站」是两件事。
        -->

        <!-- ==================== 测试 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>novel-auth</finalName>
        <plugins>
            <!-- ★ 在父 pom 的 pluginManagement 里有配置，这里声明一次来激活它 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
