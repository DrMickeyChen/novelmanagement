<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.novel</groupId>
        <artifactId>novel-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>novel-gateway</artifactId>
    <name>novel-gateway</name>
    <description>小说管理系统 · 网关（8080 唯一入口，按路径转发到各服务）</description>

    <!--
      ============================================================
      M1 的网关：转发 + 【验 JWT】
      ============================================================
      ★ M1 起网关多了一件事：每个请求都要解析 Authorization 头里的 JWT、
        去 Redis 查这把 token 还在不在，然后把身份写进 X-User-* 请求头
        交给下游。见 gateway/filter/JwtAuthGlobalFilter。

      ★★ 它【仍然不做】的两件事（这是刻意的设计，不是没做完）：
          ① 不返回 401 —— token 无效就【原样放行为匿名】，
             让请求继续走到下游，由下游的 SecurityConfig 拦下并输出统一信封。
             这样对外的行为一个字节都没变。
          ② 不维护匿名路径白名单 —— 那等于把下游的 SecurityConfig
             复制一份到网关，加一个公开接口忘了同步就是一个 401。
        详见 JwtAuthGlobalFilter 的类注释。

      ★★ M1 起它【开始依赖 novel-common】了（JwtUtil / TokenStore / LoginUser /
         IdentityHeaders / RedisConfig 都在那边）。这是 M0 埋的那一枪的兑现时刻：

             novel-common 里所有 Spring starter 都是 <optional>true</optional>，
             为的就是让 spring-webmvc 传不过来 —— 网关一旦沾上 spring-webmvc
             就启动不了（见下面 gateway 本体那条注释）。

         ★ 所以引 novel-common 这件事【必须】配合一条验证命令。
           ★★ 命令本体（以及正则里那几个锚点为什么不能省）写在下面
              「网关本体」那条注释里 —— 只抄那一条，别自己写：
              M3 实测过两种「看起来也对、其实什么都验不到」的写法。

           ★★ 反例一（M1~M2 就是这么写的，M3 订正）：
                  mvn -f backend/novel-gateway/pom.xml dependency:tree
              它【静默地什么都没验到】：novel-common 从来没有 install 进本地仓库，
              Maven 只打一句 WARNING
                  The POM for com.novel:novel-common:jar:1.0.0 is missing
              就把 novel-common 当成【叶子节点】列出来 —— 而它下面那棵子树
              （spring-boot-starter-web / spring-webmvc / tomcat-embed-core 全在里面）
              一个字都不打印：退出码 0、BUILD SUCCESS、零命中。
              ★ 也就是说，把本 pom 里那条 <exclusions> 删掉，它照样「通过」。
                一条不会失败的护栏比没有护栏更糟 —— 它给人「已经验过了」的错觉。

           ★★ 反例二：跑聚合 POM 但不做段落切分。
              那三个 jar 在 novel-common 的子树里【确实存在】（M3 实测 3 命中），
              它们正是被本 pom 中 novel-common 那条依赖的 <exclusions> 挡在外面的，
              不切段就会把 novel-common 的正常依赖误判成网关的违规。
              ★ 顺带：那 3 命中就是这条护栏的【阳性对照】——
                它证明这条管道有能力失败，而不是只会打印零。
    -->

    <dependencies>

        <!--
          ==================== 共用类库（M1 新增） ====================
          ★ 只用到其中几样：JwtUtil（验签）、TokenStore（查 Redis）、
            LoginUser（承载身份）、IdentityHeaders（怎么把身份写成头）、
            RedisConfig（那个序列化白名单 —— 必须和 novel-auth 是同一份）。

          ★★ 绝对不能改成「扫描 novel-common 的包」——
            novel-common 里有一批 servlet-bound 的类
            （GlobalExceptionHandler 收 HttpServletRequest、
             RestAuthenticationEntryPoint 实现 spring-security-web 的接口、
             HeaderAuthenticationFilter 继承 OncePerRequestFilter……），
            网关的 classpath 上没有 jakarta.servlet-api，扫到就是启动失败，
            而且报错指向「缺某个类」，完全不指向「你扫多了」。
            所以 GatewayApplication 里用的是 @Import 逐个点名，
            而不是给 @SpringBootApplication 加扫描范围。
        -->
        <dependency>
            <groupId>com.novel</groupId>
            <artifactId>novel-common</artifactId>
        </dependency>

        <!--
          ==================== Redis（M1 新增） ====================
          ★ 网关为什么要连 Redis：token 的【有效性】不在 JWT 自己身上。

             JWT 只证明「这个 token 是我们签的、还没到期」，它证明不了
             「这个人还没登出、没被踢下线、角色没被改」——
             那三件事全靠 Redis 里有没有这把 key
             （novel:auth:token:{userId}:{jti}）。

          ★★ 少了它 / 配错了，症状是【全站静默登出】：
             网关读不到登录态 → 当成匿名 → 下游 401 →
             前端 request.js 的 handleUnauthorized → 清 localStorage → 跳登录页。
             见 RedisConfig 的类注释（它为什么必须单源、不能复制一份）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Lettuce 连接池：不加它每次操作都新建连接（同另外两个服务） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!--
          ==================== 网关本体 ====================
          ★★ 它会带进来 spring-boot-starter-webflux。

          这就是为什么这个 pom 里【绝对不能】出现 spring-boot-starter-web：
              Spring Cloud Gateway 跑在 WebFlux（Netty，非阻塞）上，
              而 spring-boot-starter-web 是 Spring MVC（Tomcat，一请求一线程）。
              两者同时出现在 classpath 上时，Spring Boot 会自动选 MVC，
              然后 Gateway 的自动配置直接报错退出：

                  Spring MVC found on classpath,
                  which is incompatible with Spring Cloud Gateway.

          验证这件事不能靠自觉，跑这条命令（必须零输出）：
              mvn -f backend/pom.xml dependency:tree > tree.log
              sed -n '/@ novel-gateway /,/@ novel-auth /p' tree.log \
                | grep -E "spring-boot-starter-web:jar|spring-webmvc|tomcat-embed-core|rocketmq|netty-all"

          ★★ 那条 sed 的范围【依赖 reactor 顺序】，改模块依赖前先看一眼：
             它成立的依据是「gateway 排在 auth 前面」。今天的顺序是
                 parent → common → content → interaction → gateway → auth
             （M3 实测）。★ 这个顺序是 POM 依赖图算出来的，不是谁规定的 ——
             哪天 gateway 被排到 auth 后面，范围就【永远不开始】，
             sed 一个字都不输出 → 又变回「不会失败的护栏」。
             ★ 想彻底躲开这一点，用带上游的定向构建（只跑 3 个模块，也更快）：
                 mvn -f backend/pom.xml -pl novel-gateway -am dependency:tree \
                   | sed -n '/com.novel:novel-gateway:jar/,$p' \
                   | grep -E "spring-boot-starter-web:jar|spring-webmvc:jar|tomcat-embed-core:jar|rocketmq|netty-all"
               ★ 这里 `,$p`（切到文件尾）是对的：`-am` 只带出 parent / common，
                 gateway 必然排在最后。仍然【不能】单跑本模块的 pom，理由见上面。

          ★★ 两个必须注意的地方，都是实测踩出来的：

          ① `:jar` 这个锚【不能省】。
             `grep "spring-boot-starter-web"` 会命中
                 org.springframework.boot:spring-boot-starter-webflux:jar
             —— 因为前者是后者的前缀。而 webflux 【正是网关自己要的】，
             于是这条命令会永远报一个假阳性，久而久之就没人看它了。
             （M3 实测：加宽之前先跑了一遍，唯一命中就是这条 webflux。）

          ② `rocketmq|netty-all` 是 M3 加上的，它们【不在】原来那三类里。
             M3 给 auth / content / interaction 三个服务加了 RocketMQ，
             而 rocketmq-client 会拖进来 io.netty:netty-all —— 一个 jar
             装下所有 Netty 类。网关跑的是 Boot 托管的【逐个 netty-* 模块】
             （Reactor Netty），两者混用是 NoSuchMethodError 的经典来源，
             而且【运行时才炸】，你拿不到「Spring MVC found on classpath」
             那句友好的启动期报错。

             ★ M3 实测的结论：netty-all 确实进来了，但只进了那三个服务
               （content / interaction / auth 各一个），网关里没有 ——
               因为网关根本不依赖 rocketmq，也不依赖 novel-common 的这一部分。
               这条 grep 加宽，防的是【将来有人手滑把 rocketmq 加进 common】。

          启动日志也要看一眼：应该是
              Netty started on port 8080
          而【不是】
              Tomcat started on port 8080
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>

        <!--
          ==================== 注册中心 ====================
          让网关能注册进 Nacos，并且能【发现】三个后端服务的实例
          （novel-auth / novel-content / novel-interaction）。

          ★ 路由写的是 lb://novel-content 这种形式 —— lb = load balance，
            这个 scheme 靠的就是服务发现。没有这个依赖，
            lb:// 解析不出任何地址。
        -->
        <!-- ★ artifactId 里必须带 starter：
               是 spring-cloud-starter-alibaba-nacos-discovery，
               【不是】spring-cloud-alibaba-nacos-discovery。
               少一个单词，Maven 报的是「version is missing」而不是
               「artifact 不存在」—— 因为 BOM 里根本没有那一条，
               于是它当成「用户自己写的依赖、忘了写版本」。
               查错方向会完全跑偏。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!--
          ==================== 负载均衡器（lb:// 的实现在这） ====================
          ★★ 这个依赖【不能省】，而且症状很有迷惑性。

              Spring Cloud 从 2020 版起把 Ribbon 移除了，lb:// 改由
              spring-cloud-loadbalancer 实现。而 gateway 的 starter
              【不会】自动带上它（历史上是可选的）。

              不引的话启动是好的、路由也注册了，但请求打进来会报：
                  Unable to find instance for novel-content
              或者
                  No LoadBalancerClientFilter
              ——「找不到实例」听起来像 Nacos 没注册上，会让人去查
              Nacos 控制台，而那边一切正常。真正缺的是这一行。
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!--
          ==================== 健康检查 / 路由自检 ====================
          只为一条验收命令：
              GET /actuator/gateway/routes     列出当前生效的全部路由

          ★ 光加依赖不够，还要在 application.yml 里显式 expose 它
            （默认只暴露 health）。见那边 management 那一段。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          ==================== Lombok（M1 新增） ====================

          ★★ 这个依赖是「M0 那套 optional 设计确实生效了」的第一个实证：

             M0 时本模块一个 Java 类都没有（网关的全部行为都由 yml 决定），
             所以从来没有遇到过「注解处理器不在 classpath 上」这件事。
             M1 写了 JwtAuthGlobalFilter，一上来就报
                 「程序包 lombok 不存在」「找不到符号: 类 Slf4j」

             ★ 而 novel-common 明明是带 lombok 的 —— 它传不过来，
               因为那边写的是 <optional>true</optional>：
               optional 的依赖【不会】传递给下游模块。
               这正是 M0 想要的效果（否则 spring-webmvc 早就跟着爬过来了），
               只不过它的第一个副作用落到了 lombok 头上。

             ★ 所以规则的完整形态是：
               「你在本模块的 .java 文件里用到的注解，就要在本模块的 pom 里声明」——
               不能指望从 novel-common 顺过来，一个字节都不会顺过来。

          ★ 同样是 optional：本模块用 lombok 只是编译期的事，
            不该顺着依赖树爬到别的模块去。
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

    </dependencies>

    <build>
        <finalName>novel-gateway</finalName>
        <plugins>
            <!-- ★ 在父 pom 的 pluginManagement 里有配置，这里声明一次来激活它 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
