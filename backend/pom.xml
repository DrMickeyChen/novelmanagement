<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <!-- 空 relativePath：明确表示「去仓库找父 pom」，不要在本地目录里翻 -->
        <relativePath/>
    </parent>

    <groupId>com.novel</groupId>
    <artifactId>novel-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>novel-parent</name>
    <description>小说管理系统 · 后端（第二期：多模块父 POM）</description>

    <!--
      ============================================================
      第二期 M0：单模块 → 多模块
      ============================================================
      第一期这个 pom 就是 novel-backend 本身（单体）。第二期要拆服务，
      第一个动作就是把「一个模块」变成「一个父 + 若干子」。

      ★★ artifactId 为什么从 novel-backend 改成 novel-parent：
          子模块【必须】叫 novel-backend —— spring.application.name、
          网关的 lb://novel-backend、打包出来的 jar 名、以及几期文档
          全都指着这个名字。父子同名在 Maven 里虽然合法，但
          dependency:tree 和构建日志里会出现两个 novel-backend，
          永远分不清谁是谁。父模块让出这个名字，代价是零。

      ★ M0 拆出来的三个模块（业务代码一行没拆，只是物理分层）：
          novel-common    库   —— 被所有服务共用的 Result / 异常 / JWT / 上传 / 技术配置
          novel-backend   应用 —— 第一期那个单体
          novel-gateway   应用 —— 网关，8080，唯一入口

      ★ M1 新增第四个模块（第一个真正摘出去的服务）：
          novel-auth      应用 —— 8081，com.novel.modules.system 整体搬过去

          M1 之后 novel-backend 只剩 content + interaction + ai，
          所以上面那行「第一期那个单体」到 M1 就不准了 —— 它现在
          是「除了 auth 之外的那些模块」。

      ★★ M2 把剩下的三个也拆开了（第二、第三个真正摘出去的服务）：
          novel-content     应用 —— 8082，modules/content + modules/ai 搬过去
          novel-interaction 应用 —— 8083，即【改名的】novel-backend，
                                     它现在只剩 modules/interaction

          ★ 「novel-backend」这个名字在 M2 之后就不存在了。
            M0/M1 的文档里凡是写 novel-backend:8090 的地方，在 M2 之后
            都读作 novel-interaction:8083 —— 那些文档记录的是当时的事实，
            不回头改，由 docs/M2-摘出content.md 负责写对照。

          ★ 至此四个进程的形状与大纲 §四目录结构一致：
              网关 8080 → auth 8081 / content 8082 / interaction 8083

      ★★ M3 没有新增模块 —— 这一条和上面那句预测对不上，要写清楚为什么：
          M0 那句写的是「M3 摘 interaction、M4 摘 search 时，这里还会继续长」。
          ★ 但 interaction 在 M2 就已经是独立进程了，M3 的实质【只有 MQ】
            （见 docs/M3-引入MQ.md 开头），一个模块都没加。
          ★★ 于是「模块数」这条线是 M0(+2) → M1(+1) → M2(+0，只是把
             novel-backend 改名叫 novel-interaction) → M3(+0) → M4(+1)。
             凭「每期加一个模块」去数期数会数错。
          ★ 那句预测不改掉，也不假装它应验了 —— 留着它 + 这行对照，
            比改成「M4 摘 search 时这里还会继续长」诚实。

      ★★ M4 新增第五个模块（第二个「从来不是单体的一部分」的服务）：
          novel-search      应用 —— 8084，全新的搜索服务，读写 Elasticsearch

          ★ 它和 auth / content / interaction 有一个本质区别：
            那三个是从第一期的单体里【搬】出来的（业务代码一行没改），
            novel-search 是【新写的】—— 第一期那个 ReaderSearchController
            只是个壳，真正的实现（ES 检索 + 索引同步）M4 才有。
          ★★ 它也是【唯一一个不连数据库的服务】—— 这一点直接导致了
             novel-common 里 5 个类需要加条件注解，见那些类自己的注释。

      ★ 为什么不让网关直接依赖 novel-common：
          gateway 是 WebFlux 的，classpath 上只要出现 spring-webmvc 就
          启动失败。novel-common 为了编译需要 webmvc，所以它的 Spring
          依赖全部标了 optional（见 novel-common/pom.xml 里那段长注释）。

          M0 的网关用不上 common 的类，索性不依赖；★★ M1 的网关【必须】
          用 JwtUtil / TokenStore 了，那一枪在这里兑现 —— 靠的就是那组
          optional：common 的类能进网关，webmvc 传不过来。
          M1 的网关仍然【不扫描】common（扫进去会把 servlet 类也拉进来），
          改成在 GatewayApplication 上 @Import 那三个类，见那边的注释。
    -->

    <!--
      ★★ 顺序即构建顺序（Maven 的 reactor 会按依赖关系再排一次，这里只是可读性）。
          novel-common 必须最先 —— 它从没被 install 进本地仓库，
          只有聚合 POM 在 reactor 内解析得到它（见 CLAUDE.md 的「环境」段）。
    -->
    <modules>
        <module>novel-common</module>
        <module>novel-content</module>
        <module>novel-interaction</module>
        <module>novel-gateway</module>
        <module>novel-auth</module>
        <!-- ★ M4 新增。★ 放最后不是随意的：它依赖 novel-common，排在其后读起来顺 -->
        <module>novel-search</module>
    </modules>

    <properties>
        <!--
          ★★★ 你本机装的是 JDK 24，但这里必须锁死按 Java 21 编译 ★★★
          Spring Boot 3.2.x 官方支持上限就是 Java 21。不写 maven.compiler.release
          的话，编译器会按 JDK 24 出字节码，运行时可能出现各种
          「类文件版本不对」「反射被拒绝」的怪问题，而且报错信息完全指不到这里。

          ★ 这些属性放在父 pom 里，三个子模块自动继承 —— 尤其
            lombok.version 那条，少一个模块继承就会在那个模块上编译失败。
        -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!--
          ★ 覆盖 Spring Boot 3.2.12 默认的 Lombok 1.18.36
          那个版本只支持到 JDK 23，在你的 JDK 24 上会直接编译失败
          （报 java.lang.NoSuchFieldError: qualifiedName 之类）。
        -->
        <lombok.version>1.18.42</lombok.version>

        <!-- MyBatis-Plus：Spring Boot 3 必须用 spring-boot3 这个 artifactId -->
        <mybatis-plus.version>3.5.9</mybatis-plus.version>

        <!-- Knife4j：内部依赖 springdoc-openapi 2.3.0，正好配套 Spring Boot 3.2.x -->
        <knife4j.version>4.5.0</knife4j.version>

        <!-- JWT：第一期 P1 认证阶段才会用到，先把版本号定下来 -->
        <jjwt.version>0.12.6</jjwt.version>

        <!--
          ============================================================
          第二期 M3 新增：RocketMQ（消息队列）
          ============================================================
          ★★★ 属性名【不能】叫 rocketmq.version ★★★

          咱们 import 的 SCA BOM（spring-cloud-alibaba-dependencies:2023.0.3.2）
          内部【已经有一个同名属性】：
                  <rocketmq.version>5.3.1</rocketmq.version>
          它管着 org.apache.rocketmq:rocketmq-client 和 rocketmq-acl。

          Maven 的规矩是「import 一个 BOM 只带版本、【不带】它的 <properties>」，
          所以在这里写 rocketmq.version=2.3.6 并不会真的改掉 rocketmq-client 的版本
          （它仍然解析成 5.3.1）—— 但它会严重误导读代码的人。

          更坏的是：下一个人看到这个名字，只要在自己模块里写一条
                  <artifactId>rocketmq-client</artifactId>
                  <version>${rocketmq.version}</version>
          就会把客户端【静默锁到 2.3.6】这个 rocketmq-client 压根不存在的版本上，
          然后对着一个莫名其妙的解析错误发呆。

          所以这里叫 rocketmq-spring.version —— 名字里就写着它是
          【rocketmq-spring（那个 Spring Boot starter）】的版本，不是 client 的。
        -->
        <rocketmq-spring.version>2.3.6</rocketmq-spring.version>

        <!--
          ============================================================
          第二期 M0 新增：Spring Cloud 的两个版本号
          ============================================================
          ★★ 这三行是一个【整体】，不能单独升其中一个：

              Spring Boot 3.2.x  ←→  Spring Cloud 2023.0.x
                                 ←→  Spring Cloud Alibaba 2023.0.3.2

          Spring Cloud 的版本号从 2020 年起就不再是数字了，改成了
          「年份.第几次发布」的伦敦地铁站名。2023.0.x 这一条线的
          官方支持矩阵写的就是 Spring Boot 3.2.x —— 升到 2023.0.4
          或者 2024.0.x 都要连着升 Spring Boot，不是改一个数字的事。
        -->
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.3.2</spring-cloud-alibaba.version>
    </properties>

    <!--
      ============================================================
      dependencyManagement：只管版本，不引入依赖
      ============================================================
      子模块里写 <dependency> 时【不写 <version>】，版本由这里决定。
      import 进来的 BOM 也是同样的作用，只是把一整批版本号打包带进来。
    -->
    <dependencyManagement>
        <dependencies>

            <!--
              ★★ 顺序不能反：dependencyManagement 的 import 是【先到先得】。
                  同一条依赖被两个 BOM 都管着时，写在前面的那个赢。

                  所以 Spring Cloud 的 BOM 必须在前面 —— 它负责把
                  spring-cloud-gateway / spring-cloud-commons /
                  spring-cloud-loadbalancer 这些锁在 2023.0.3。
                  SCA 的 BOM 放在后面，只补它独有的（nacos-client 等），
                  并且它内部也会 import 一份 Spring Cloud BOM，不会冲突。

                  反过来的话，SCA 里那份传递进来的 Spring Cloud 版本
                  会先占位，实际生效的版本和你以为写着的 2023.0.3 不是一回事
                  （而且不会报错，只会行为诡异）。
            -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
              ============================================================
              下面这几个不在任何 BOM 里，得自己管
              ============================================================
              ★ 这些版本号本来写死在原来的单模块 pom 的每个 <dependency> 里。
                拆成多模块后【必须】上提到这里 —— 否则 novel-common 和
                各个服务模块各写一份，迟早出现「common 用 3.5.9、
                某个服务用 3.5.8」这种两个版本同时进 classpath 的情况
                （而且是静默的，只在某些类的行为上体现出来）。
            -->

            <!-- ★ 版本号来自上面的 <properties>，改版本只改一个地方 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!--
              jjwt 三件套：api 编译期用，impl / jackson 运行时用。
              ★ 三个版本必须完全一致 —— api 和 impl 版本错开会在
                解析 token 时抛 NoSuchMethodError 之类，报错完全指不到版本。
            -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!--
              ============================================================
              M3：RocketMQ 的 Spring Boot starter
              ============================================================
              ★★ 为什么这一条必须自己写、BOM 给不了：

                  SCA 的 BOM 确实管着 RocketMQ（rocketmq-client / rocketmq-acl
                  都锁在 5.3.1，正好等于 docker-compose 里 broker 镜像的版本），
                  但它【不管 rocketmq-spring-boot-starter】——
                  而 RocketMQTemplate / @RocketMQMessageListener /
                  @RocketMQTransactionListener 全都在这个 starter 里。

                  另一个候选是 BOM 管的 spring-cloud-starter-stream-rocketmq，
                  但那是 Spring Cloud Stream 的函数式模型（Consumer<Message<T>>），
                  【不支持事务消息】—— 而 M3 断掉 auth ⇄ content 那个环
                  靠的正是事务消息。所以那条路走不通。

              ★ 版本 2.3.6 的由来（两条下限，都不是拍脑袋）：
                  ① Spring Boot 3 的下限是 2.2.3 —— 从那一版起才改用 jakarta.*，
                     2.2.0 及以下在 Boot 3 上自动装配直接失效；
                  ② Boot 3.2 + JDK17+ 有一个已知 bug：
                     NoClassDefFoundError: .../protocol/heartbeat/MessageModel，
                     2.3.2 起才修（RocketMQ 改了包路径）。
                  取 2.3.6 = 本机镜像仓库里的最新 release，两条下限都远在身后。

              ★★ M3 时有 auth / content / interaction 三个服务引用它；
                  ★ M4 起是【四个】—— novel-search 也引（它要消费 NOVEL_INDEX）。
                  novel-common 【不引】，novel-gateway 【也不引】——
                  见那两个 pom 里各自的说明。这样网关的 classpath
                  结构上就不可能因为 M3 而变化。
                  ★ 网关那条结论 M4 仍然成立：它至今没碰过 MQ。
                  ★★ 但「新增一个引 MQ 的服务」这件事本身值得记一笔：
                     它说明这条依赖【不是】某三个服务的专属，而是一条
                     普通的业务依赖 —— 否则每次拆服务都要回来重新论证一次。
            -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq-spring.version}</version>
            </dependency>

            <!--
              自己的模块也用 dependencyManagement 管起来。
              这样四个服务模块（auth / content / interaction / gateway）
              引用 novel-common 时
              只写 groupId + artifactId，版本跟着父 pom 走，
              不会出现「common 升了版本但 backend 还写着旧的」。
            -->
            <dependency>
                <groupId>com.novel</groupId>
                <artifactId>novel-common</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!--
      ============================================================
      build
      ============================================================
    -->
    <build>

        <!--
          ★ <plugins> 里的东西【三个模块都继承】，这是有意的：
              编译器插件带着 lombok 的 annotationProcessorPaths，
              novel-common 缺了它会在 JDK 24 上编译失败。
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!-- 保留方法参数名，MyBatis 的 #{name} 绑定和 Spring 的
                         @RequestParam 推断都依赖它 -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>

        <!--
          ★★ spring-boot-maven-plugin 只放在 <pluginManagement>，【不放在 <plugins>】。

              区别是：pluginManagement 只提供配置，子模块【声明了才生效】；
              放在 plugins 里则是无条件对所有模块生效。

              为什么不能无条件生效：
                  repackage 会把模块打成「可执行 fat jar」—— jar 里内嵌
                  一个 BOOT-INF/lib 和自定义的启动类，并且把原来的 jar
                  改名成 .original。

                  novel-common 是个【库】，它要被各个服务模块当依赖读。
                  打成 fat jar 之后，下游拿到的 class 文件被塞进了
                  BOOT-INF/classes/ 这个非标准位置，编译期直接找不到类
                  —— 报「找不到符号」，而源码明明就在那儿。

                  所以：四个服务模块（auth / content / interaction /
                  gateway）各自在 <build><plugins> 里声明一次来激活它，
                  novel-common 不声明。
        -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <!-- Lombok 只在编译期用，不打进最终的 jar -->
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

    </build>

</project>
