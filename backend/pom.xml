<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <!-- 空 relativePath：明确表示「去仓库找父 pom」，不要在本地目录里翻 -->
        <relativePath/>
    </parent>

    <groupId>com.novel</groupId>
    <artifactId>novel-backend</artifactId>
    <version>1.0.0</version>
    <name>novel-backend</name>
    <description>小说管理系统 · 后端（第一期：单体）</description>

    <!--
      ============================================================
      第一期：单模块
      ============================================================
      按 项目大纲.md §九 的三期计划，第一期 backend/ 就是这一个模块，
      所有业务跑在一个进程里。第二期才拆成 gateway / auth / content /
      interaction / search 五个服务 —— 到那时这个 pom 会变成父 pom，
      下面的模块是子 pom，业务代码基本不用动。

      所以现在不要提前建多模块，那只会让第一期的开发变慢。
      ============================================================
    -->

    <properties>
        <!--
          ★★★ 你本机装的是 JDK 24，但这里必须锁死按 Java 21 编译 ★★★
          Spring Boot 3.2.x 官方支持上限就是 Java 21。不写 maven.compiler.release
          的话，编译器会按 JDK 24 出字节码，运行时可能出现各种
          「类文件版本不对」「反射被拒绝」的怪问题，而且报错信息完全指不到这里。
        -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!--
          ★ 覆盖 Spring Boot 3.2.12 默认的 Lombok 1.18.36
          那个版本只支持到 JDK 23，在你的 JDK 24 上会直接编译失败
          （报 java.lang.NoSuchFieldError: qualifiedName 之类）。
        -->
        <lombok.version>1.18.42</lombok.version>

        <!-- MyBatis-Plus：Spring Boot 3 必须用 spring-boot3 这个 artifactId -->
        <mybatis-plus.version>3.5.9</mybatis-plus.version>

        <!-- Knife4j：内部依赖 springdoc-openapi 2.3.0，正好配套 Spring Boot 3.2.x -->
        <knife4j.version>4.5.0</knife4j.version>

        <!-- JWT：第一期 P1 认证阶段才会用到，先把版本号定下来 -->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>

        <!-- ==================== Web ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：@NotNull / @Size / @Email 这些注解靠它 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ==================== 持久层 ==================== -->
        <!--
          ★ Spring Boot 3 要用 mybatis-plus-spring-boot3-starter
            用老的 mybatis-plus-boot-starter 会启动报
            「NoClassDefFoundError: javax/servlet/...」—— 因为它还是 javax 时代的包
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!--
          ★ 从 3.5.9 开始，MyBatis-Plus 把 jsqlparser 拆成了独立依赖。
            分页插件 PaginationInnerInterceptor 内部要用它解析 SQL 来拼 LIMIT，
            不引这个包，第一次调分页接口就会报：
                java.lang.NoClassDefFoundError: net/sf/jsqlparser/statement/select/Select
            报错信息里完全看不出和分页插件有关，很容易卡住。
            用 mybatis-plus-jsqlparser（对应 jsqlparser 5.x）即可，
            另一个 mybatis-plus-jsqlparser-4.9 是给还依赖 jsqlparser 4.9 的老项目用的。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 缓存 / 会话 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Lettuce 连接池：不加它 Redis 每次操作都新建连接，压测时很难看 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- ==================== 接口文档 ==================== -->
        <!-- 启动后访问 http://localhost:8080/doc.html -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>${knife4j.version}</version>
        </dependency>

        <!-- ==================== 工具 ==================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          ==================== 以下依赖第一期 P1 再加 ====================

          认证授权（P1 阶段）：
          <dependency>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-starter-security</artifactId>
          </dependency>
          <dependency>
              <groupId>io.jsonwebtoken</groupId>
              <artifactId>jjwt-api</artifactId>
              <version>${jjwt.version}</version>
          </dependency>
          <dependency>
              <groupId>io.jsonwebtoken</groupId>
              <artifactId>jjwt-impl</artifactId>
              <version>${jjwt.version}</version>
              <scope>runtime</scope>
          </dependency>
          <dependency>
              <groupId>io.jsonwebtoken</groupId>
              <artifactId>jjwt-jackson</artifactId>
              <version>${jjwt.version}</version>
              <scope>runtime</scope>
          </dependency>

          ★ 注意：spring-boot-starter-security 一旦引入就会【自动拦截所有接口】，
            连 /api/ping 都访问不了 —— 必须同时写好 SecurityConfig 放行规则。
            所以 P0 阶段先不加，等 P0 验收完、开始做登录功能时再一起加。
        -->

        <!-- ==================== 测试 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>novel-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Lombok 只在编译期用，不打进最终的 jar -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!-- 保留方法参数名，MyBatis 的 #{name} 绑定和 Spring 的
                         @RequestParam 推断都依赖它 -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
