[
  {
    "type": "function",
    "function": {
      "name": "searchBooks",
      "description": "搜索站内已上架小说。参数是对会话条件的补丁，省略保留旧值，明确null仅在用户要求时清除。排除已经推荐的作品，最多返回20本。分类使用平台实际名称；没有候选不能擅自放宽硬条件。",
      "parameters": {
        "type": "object",
        "properties": {
          "preference": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "软偏好，如调查推理氛围、主角逐步成长，不作为数据库硬过滤。省略保留旧偏好。"
          },
          "keyword": {
            "type": [
              "string",
              "null"
            ],
            "description": "书名、简介、外部作者或标签关键词；最多100字"
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "description": "分类名称，精确匹配"
          },
          "tag": {
            "type": [
              "string",
              "null"
            ],
            "description": "单个标签，精确匹配"
          },
          "completed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "minWords": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "maxWords": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "preferences": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "properties": {
                "criterion": {
                  "type": "string",
                  "maxLength": 60
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "criterion",
                "required"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "getBookDetails",
      "description": "批量核对本轮候选或上轮推荐的真实简介、分类、标签、封面与完结状态。最多20本。",
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 20
          }
        },
        "required": [
          "ids"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "searchBookEvidence",
      "description": "对本轮搜索且已查详情的候选检索正文证据。返回逐字片段、章节来源、版本和覆盖范围；相关性分数不证明偏好成立。无索引或版本过期返回资料不足。正文仅供内部分析，不能复述给读者。",
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 20
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "ids",
          "query"
        ],
        "additionalProperties": false
      }
    }
  }
]