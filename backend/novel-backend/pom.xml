<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.novel</groupId>
        <artifactId>novel-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>novel-backend</artifactId>
    <name>novel-backend</name>
    <description>小说管理系统 · 第一期那个单体（第二期 M0 起退到 8090，由网关转发进来）</description>

    <!--
      ============================================================
      这个模块 = 第一期的整个后端，一个字节的业务代码都没拆
      ============================================================
      M0 只做了两件事：
        ① 把 com.novel.common 那 23 个类搬到 novel-common（包名没变）
        ② 端口从 8080 让给网关，自己退到 8090

      ★ M1 起会从【这个模块】里往外摘服务（先 auth，再 content...）。
        所以 M0 之后，这里的每一行都还是第一期的样子 ——
        网关转发过来的请求，最终就是由这里处理的。
    -->

    <dependencies>

        <!-- 第一期搬过来的那 23 个类。版本由父 pom 的 dependencyManagement 给 -->
        <dependency>
            <groupId>com.novel</groupId>
            <artifactId>novel-common</artifactId>
        </dependency>

        <!-- ==================== Web ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：@NotNull / @Size / @Email 这些注解靠它 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          ==================== 注册中心（M0 新增） ====================
          ★ 只加这一个依赖，单体就变成了 Nacos 上的一个服务实例，
            网关的 lb://novel-backend 才找得到它。

          ★ 配置在 application-dev.yml 的 spring.cloud.nacos.discovery 下。
            那里有一条 ★★ 注释解释「为什么 username/password 必须写在
            discovery 下面，而不是只写 spring.cloud.nacos 那一层」。

          ★ 为什么【不加】spring-cloud-starter-loadbalancer：
            单体是服务【提供方】，不是消费方 —— 它不需要去发现别人。
            LB 是网关（消费方）的事，加在这里纯属多一个变量。
        -->
        <!-- ★ artifactId 里必须带 starter（同 novel-gateway 那条注释） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ==================== 持久层 ==================== -->
        <!--
          ★ Spring Boot 3 要用 mybatis-plus-spring-boot3-starter
            用老的 mybatis-plus-boot-starter 会启动报
            「NoClassDefFoundError: javax/servlet/...」—— 因为它还是 javax 时代的包
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!--
          ★ 从 3.5.9 开始，MyBatis-Plus 把 jsqlparser 拆成了独立依赖。
            分页插件 PaginationInnerInterceptor 内部要用它解析 SQL 来拼 LIMIT，
            不引这个包，第一次调分页接口就会报：
                java.lang.NoClassDefFoundError: net/sf/jsqlparser/statement/select/Select
            报错信息里完全看不出和分页插件有关，很容易卡住。
            用 mybatis-plus-jsqlparser（对应 jsqlparser 5.x）即可，
            另一个 mybatis-plus-jsqlparser-4.9 是给还依赖 jsqlparser 4.9 的老项目用的。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 缓存 / 会话 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Lettuce 连接池：不加它 Redis 每次操作都新建连接，压测时很难看 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- ==================== 接口文档 ==================== -->
        <!--
          ★ 第二期 M0 起，接口文档直连 http://localhost:8090/doc.html。
            它【不走网关】—— 原因见 docs/M0-骨架搭建.md「为什么文档不进网关」：
            /doc.html 内部还会去拉 /webjars/** 和 /v3/api-docs/**，
            要透传就得给这一整套加路由，还要处理 X-Forwarded-* 和
            springdoc 的 server 推断，是一件独立的、会把 M0 拖长的活。
            这是开发期唯一一个不走 :3000 的入口。
        -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <!-- ==================== 工具 ==================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================== 认证授权（P1） ==================== -->

        <!--
          ★★ spring-boot-starter-security 一旦引入就会【自动拦截所有接口】，
             连 /api/ping 都访问不了 —— 放行规则写在 com.novel.config.SecurityConfig。
             这两者必须同时存在，单独加依赖 = 全站 401。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
          ★ jjwt-impl / jjwt-jackson 不再在这里声明了：novel-common 已经
            用 runtime scope 引了它们，会传递到这里。

            留在这里也不会出错（Maven 会去重），只是同一个东西写两遍
            将来一定会分叉。JWT 相关的依赖统一由 novel-common 负责 ——
            因为 JwtUtil 在那边。
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>

        <!-- ==================== 服务间调用（M1） ==================== -->

        <!--
          ★★ OpenFeign：M1 起 content 要拿作者昵称，而去查 sys_user 的那段 SQL
             已经跟着 modules/system 搬进了 novel-auth。跨进程了，只能走 HTTP。

          ★ 版本由父 pom import 的 spring-cloud-dependencies BOM 给
            （spring-cloud-starter-openfeign 在那个 BOM 里），所以这里不写 <version>。
            ★★ 父 pom 里那两个 BOM 的 import 顺序【不能反】：
               先 spring-cloud（它锁 openfeign / loadbalancer / gateway 的版本），
               后 spring-cloud-alibaba（只补它独有的 nacos-client）。
               import 是「先到先得」，反过来会让 SCA 的旧版本盖住 spring-cloud 的。
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!--
          ★★ loadbalancer 必须【显式】加，它不是 openfeign 的传递依赖。
             漏了它的症状：启动就失败，报
               「No Feign Client for loadBalancing defined.
                 Did you forget to include spring-cloud-starter-loadbalancer?」
             —— 这句话本身已经把答案写出来了，所以还算好查；
             真正难查的是「以为注册中心能自己兜住」而不加。

          ★ 为什么 Feign 需要它：@FeignClient(name = "novel-auth") 里的
            name 是【服务名】不是主机名，Feign 得靠 loadbalancer 去 Nacos
            把服务名解析成实例地址。没有它，Feign 不知道 novel-auth 在哪台机器上。
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- ==================== 测试 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <!--
          ★ finalName 保持 novel-backend —— 启动命令、文档、jar 名都指着它。
            父 pom 的 artifactId 从 novel-backend 改成 novel-parent
            就是为了把这个名字腾出来（见父 pom 顶部那段）。
        -->
        <finalName>novel-backend</finalName>
        <plugins>
            <!-- ★ 在父 pom 的 pluginManagement 里有配置，这里声明一次来激活它 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
