# ============================================================
# 在虚拟机上执行：cp .env.example .env  然后按下面的说明改
#
# ★ .env 里有密码，不要提交到 git。项目初始化 git 后，
#   第一件事就是把 docs/docker/.env 加进 .gitignore。
# ============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root123456

# --- Redis ---
REDIS_PASSWORD=redis123456

# --- Nacos 鉴权 ---
# NACOS_AUTH_TOKEN 必须是【Base64 编码后至少 32 字节】的字符串。
# 下面这个只是占位，请自己生成一个：
#     openssl rand -base64 32
NACOS_AUTH_TOKEN=VGhpc0lzQURldlRva2VuRm9yTm92ZWxNYW5hZ2VyUHJvamVjdA==

# --- RocketMQ ---
# ★ 填虚拟机的局域网 IP（`hostname -I` 看到的那个），不是 127.0.0.1。
#
#   这一项会传给 docker-compose.yml，但【不会】自动同步到 broker.conf ——
#   broker.conf 是文件挂载进容器的，拿不到 shell 环境变量。
#   所以改完这里，必须同步改 broker.conf 里的 brokerIP1，两处保持一致。
RMQ_BROKER_IP=192.168.127.137
